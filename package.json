{
	"name": "tickbox",
	"version": "0.2.0",
	"description": "Clickable checkboxes in Markdown table cells for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run test/unit",
		"e2e": "tsx test/e2e/run.ts",
		"install-vault": "node scripts/install-vault.mjs"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "6.11.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"playwright-core": "1.64.1",
		"tsx": "4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "5.1.2"
	},
	"author": "Merkurial-Studio - Arnar Valur",
	"repository": {
		"type": "git",
		"url": "https://github.com/ArnarValur/obsidian-tickbox.git"
	}
}
